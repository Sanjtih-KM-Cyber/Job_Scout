# backend/.env.example
# Copy to .env and fill in your values

PORT=4000

# Redis — free instance at https://upstash.com
REDIS_URL=redis://localhost:6379

# Google Gemini — get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_KEY_HERE

# Frontend origin (for CORS)
CORS_ORIGIN=http://localhost:5173

# Chrome binary path for Puppeteer (LinkedIn scraper)
# macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux:   /usr/bin/google-chrome-stable
# Railway: set via nixpacks.toml  (see docs/ARCHITECTURE.md)
CHROME_PATH=/usr/bin/google-chrome-stable
